# asset_manager/styles.tcss
/* Global styles */
Screen {
    background: $panel;
}

.title {
    text-align: center;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.subtitle {
    text-align: center;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 2;
}

/* Button styles */
Button {
    margin: 1 2;
}

Button.primary {
    border: tall $primary;
    background: $primary;
}

Button.success {
    border: tall $success;
    background: $success;
}

Button.warning {
    border: tall $warning;
    background: $warning;
}

Button.error {
    border: tall $error;
    background: $error;
}

Button.default {
    border: tall $secondary;
    background: $secondary;
}

/* Input styles */
Input {
    width: 100%;
    margin: 0 2;
}

/* Table styles */
DataTable {
    height: 1fr;
    border: solid $primary;
    margin: 1 2;
}

/* Container styles */
Container {
    layout: vertical;
    padding: 1;
}

Vertical {
    align: center middle;
    height: 1fr;
}

Horizontal {
    align: center middle;
    margin: 1 0;
}

Center {
    align: center middle;
    height: auto;
}

/* Footer styling */
Footer {
    dock: bottom;
    background: $surface;
    color: $text;
    height: 3;
}

/* Import Modal Styles */
ImportModalScreen {
    align: center middle;
    padding: 1;
}

#instruction-label {
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
    content-align: center middle;
}

#main-container {
    width: 100%;
    height: 1fr;
    margin: 1;
}

/* Left Panel: File Tree */
#file-tree {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    margin-right: 1;
}

/* Right Panel: Controls and Preview */
#right-panel {
    width: 2fr;
    height: 100%;
}

#file-path-input {
    margin-bottom: 1;
}

#button-row {
    height: auto;
    margin: 1 0;
    align: center middle;
}

#button-row Button {
    margin: 0 1;
    min-width: 16;
}

#preview-table {
    height: 1fr;
    border: solid $secondary;
    margin-top: 1;
}
